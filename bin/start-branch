#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
  cat <<'EOF'
Usage: bin/start-branch BRANCH_NAME [-b BASE_BRANCH] [--stash]

Fetch latest BASE_BRANCH from origin, check it out, and create BRANCH_NAME from it.

Options:
  -b, --base BRANCH   Base branch on origin (default: main)
  --stash             Stash uncommitted changes before branching, pop after checkout
  -h, --help          Show this help

Safety:
  - Refuses to run with uncommitted changes unless --stash is passed
  - Refuses if BRANCH_NAME is main or master
  - Refuses if the branch already exists locally or on origin
EOF
}

BASE_BRANCH="main"
BRANCH_NAME=""
STASH=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -b|--base)
      BASE_BRANCH="${2:?missing argument for $1}"
      shift 2
      ;;
    --stash)
      STASH=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "error: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ -n "${BRANCH_NAME}" ]]; then
        echo "error: multiple branch names: ${BRANCH_NAME} and $1" >&2
        exit 1
      fi
      BRANCH_NAME="$1"
      shift
      ;;
  esac
done

if [[ -z "${BRANCH_NAME}" ]]; then
  echo "error: branch name required" >&2
  usage >&2
  exit 1
fi

if [[ "${BRANCH_NAME}" == "main" || "${BRANCH_NAME}" == "master" ]]; then
  echo "error: refuse to create branch named ${BRANCH_NAME}" >&2
  exit 1
fi

if ! [[ "${BRANCH_NAME}" =~ ^[a-z0-9][a-z0-9/_-]*$ ]]; then
  echo "error: invalid branch name: ${BRANCH_NAME}" >&2
  echo "Use lowercase letters, numbers, hyphens, underscores, and slashes." >&2
  exit 1
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
  if [[ "${STASH}" == true ]]; then
    git stash push -u -m "start-branch: auto-stash before ${BRANCH_NAME}"
    STASHED=true
  else
    echo "error: working tree not clean; commit, stash, or pass --stash" >&2
    exit 1
  fi
fi

echo "Fetching origin..."
git fetch origin

REMOTE="origin/${BASE_BRANCH}"
if ! git rev-parse --verify "${REMOTE}" >/dev/null 2>&1; then
  echo "error: ${REMOTE} not found; check remote and base branch name" >&2
  exit 1
fi

if git show-ref --verify --quiet "refs/heads/${BRANCH_NAME}"; then
  echo "error: local branch ${BRANCH_NAME} already exists" >&2
  exit 1
fi

if git ls-remote --exit-code --heads origin "${BRANCH_NAME}" >/dev/null 2>&1; then
  echo "error: remote branch ${BRANCH_NAME} already exists on origin" >&2
  exit 1
fi

git checkout "${BASE_BRANCH}" 2>/dev/null || git checkout -b "${BASE_BRANCH}" --track "${REMOTE}"
git pull --ff-only origin "${BASE_BRANCH}"
git checkout -b "${BRANCH_NAME}"

if [[ "${STASHED:-false}" == true ]]; then
  git stash pop
fi

echo "Ready on ${BRANCH_NAME} (from origin/${BASE_BRANCH})"
