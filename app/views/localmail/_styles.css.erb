:root {
  --lm-black: #111;
  --lm-text: #494949;
  --lm-muted: #8c8c8c;
  --lm-line: #eaeaea;
  --lm-wash: #f9f9f9;
  --lm-white: #fff;
  --lm-danger: #c62828;
  --lm-danger-wash: #fdecea;
  --lm-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
* { box-sizing: border-box; }
.lm-body { margin: 0; min-height: 100vh; background: var(--lm-wash); color: var(--lm-text); font: 14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
.lm-container { width: 100%; max-width: 72rem; margin: 0 auto; padding: 0 1rem; }
.lm-header { background: var(--lm-black); color: var(--lm-white); }
.lm-header-inner { display: flex; align-items: center; justify-content: space-between; padding-top: .75rem; padding-bottom: .75rem; }
.lm-brand { color: var(--lm-white); font-weight: 600; font-size: 1rem; text-decoration: none; }
.lm-muted { color: var(--lm-muted); }
.lm-small { font-size: .75rem; margin: 0; }
.lm-label { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--lm-muted); }
.lm-toolbar { background: var(--lm-white); border-bottom: 1px solid var(--lm-line); }
.lm-toolbar-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; padding-top: .75rem; padding-bottom: .75rem; }
.lm-toolbar-actions { margin-left: auto; display: flex; align-items: center; gap: .5rem; }
.lm-toolbar-actions form { margin: 0; }
.lm-strong { font-weight: 600; color: var(--lm-black); }
.lm-link { color: var(--lm-black); font-weight: 500; text-decoration: none; }
.lm-link:hover { text-decoration: underline; }
.lm-button { display: inline-block; border: 1px solid var(--lm-line); border-radius: .5rem; background: var(--lm-white); color: var(--lm-black); padding: .5rem 1rem; font: inherit; font-weight: 500; text-decoration: none; cursor: pointer; }
.lm-button:hover { background: var(--lm-wash); }
.lm-button-danger { color: var(--lm-danger); }
.lm-button-danger:hover { background: var(--lm-danger-wash); }
.lm-page { padding-top: 2rem; padding-bottom: 2rem; }
.lm-card { overflow: hidden; background: var(--lm-white); border: 1px solid var(--lm-line); border-radius: .75rem; box-shadow: 0 1px 2px rgb(0 0 0 / .05); }
.lm-empty { max-width: 48rem; margin: 0 auto; padding: 1.5rem; text-align: center; }
.lm-empty h1 { margin: 0; font-size: 1.125rem; color: var(--lm-black); }
.lm-empty p { margin: .25rem auto 0; max-width: 28rem; color: var(--lm-muted); }
.lm-list { list-style: none; margin: 0; padding: 0; }
.lm-row { position: relative; display: flex; align-items: center; gap: 1rem; padding: 1rem 1.5rem; border-top: 1px solid var(--lm-line); }
.lm-row:first-child { border-top: 0; }
.lm-row:hover { background: var(--lm-wash); }
.lm-time { display: flex; flex-direction: column; flex-shrink: 0; width: 6rem; padding-right: 1rem; border-right: 1px solid var(--lm-line); text-align: right; }
.lm-time-clock { font-family: var(--lm-mono); color: var(--lm-black); font-variant-numeric: tabular-nums; }
.lm-row-main { flex: 1; min-width: 0; }
.lm-row-subject { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; color: var(--lm-black); text-decoration: none; }
.lm-row-subject::after { content: ""; position: absolute; inset: 0; }
.lm-row-subject:hover { text-decoration: underline; }
.lm-row-to { margin: .25rem 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--lm-mono); font-size: .75rem; color: var(--lm-muted); }
.lm-row-delete { position: relative; flex-shrink: 0; }
.lm-row-delete form { margin: 0; }
.lm-row-delete .lm-button { border-color: transparent; background: transparent; color: var(--lm-muted); padding: .375rem .75rem; }
.lm-row-delete .lm-button:hover { border-color: var(--lm-line); background: var(--lm-white); color: var(--lm-danger); }
.lm-meta { padding: 1.5rem; }
.lm-meta h1 { margin: 0; font-size: 1.125rem; color: var(--lm-black); }
.lm-headers { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: .375rem 1rem; margin: 1rem 0 0; font-family: var(--lm-mono); font-size: .75rem; }
.lm-headers dt { text-transform: uppercase; letter-spacing: .05em; color: var(--lm-muted); }
.lm-headers dd { margin: 0; word-break: break-all; }
.lm-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.lm-tabs { display: flex; border-top: 1px solid var(--lm-line); padding: 0 1.5rem; }
.lm-tabs label { margin-bottom: -1px; padding: .75rem 1rem; border-bottom: 2px solid transparent; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--lm-muted); cursor: pointer; }
.lm-tabs label:first-child { padding-left: 0; }
.lm-tabs label:hover { color: var(--lm-black); }
#view-0:checked ~ .lm-tabs .lm-tab-0,
#view-1:checked ~ .lm-tabs .lm-tab-1,
#view-2:checked ~ .lm-tabs .lm-tab-2 { color: var(--lm-black); border-bottom-color: var(--lm-black); }
#view-0:focus-visible ~ .lm-tabs .lm-tab-0,
#view-1:focus-visible ~ .lm-tabs .lm-tab-1,
#view-2:focus-visible ~ .lm-tabs .lm-tab-2 { outline: 2px solid var(--lm-black); outline-offset: -2px; }
.lm-viewport { display: none; align-items: center; justify-content: center; gap: .5rem; padding: .75rem 1.5rem; border-top: 1px solid var(--lm-line); }
#view-0:checked ~ .lm-viewport { display: flex; }
.lm-viewport label { display: flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border: 1px solid var(--lm-line); border-radius: .5rem; background: var(--lm-white); color: var(--lm-muted); font-weight: 500; cursor: pointer; }
.lm-viewport label:hover { background: var(--lm-wash); color: var(--lm-black); }
.lm-viewport svg { width: 1rem; height: 1rem; flex-shrink: 0; }
#vp-desktop:checked ~ .lm-viewport .lm-vp-desktop,
#vp-mobile:checked ~ .lm-viewport .lm-vp-mobile { border-color: var(--lm-black); color: var(--lm-black); }
#vp-desktop:focus-visible ~ .lm-viewport .lm-vp-desktop,
#vp-mobile:focus-visible ~ .lm-viewport .lm-vp-mobile { outline: 2px solid var(--lm-black); outline-offset: -2px; }
.lm-panels { padding: 1rem; border-top: 1px solid var(--lm-line); background: var(--lm-wash); }
.lm-panel { display: none; }
#view-0:checked ~ .lm-panels .lm-p0,
#view-1:checked ~ .lm-panels .lm-p1,
#view-2:checked ~ .lm-panels .lm-p2 { display: block; }
.lm-frame { display: block; width: 100%; max-width: 100%; height: 72vh; min-height: 420px; margin: 0 auto; border: 0; border-radius: .5rem; background: var(--lm-white); box-shadow: 0 1px 2px rgb(0 0 0 / .05); transition: max-width 150ms ease; }
#vp-mobile:checked ~ .lm-panels .lm-frame { max-width: 390px; }
.lm-source { max-height: 72vh; margin: 0; overflow: auto; padding: 1rem; white-space: pre-wrap; word-break: break-word; border: 1px solid var(--lm-line); border-radius: .5rem; background: var(--lm-white); font-family: var(--lm-mono); font-size: .75rem; line-height: 1.6; }
@media (min-width: 640px) { .lm-panels { padding: 1.5rem; } }
@media (max-width: 639px) { .lm-time { display: none; } .lm-row { padding: 1rem; } }
